#!/bin/sh
# Prueba de red y paquetes (se activa con lab=red en la linea de comandos del kernel).
sleep 1
echo "=== prueba de red y paquetes ==="
echo "--- interfaces antes de levantar la red:"
ip -o link show | awk '{print $2, $3}'
ip link set eth0 up
echo "--- DHCP (udhcpc):"
udhcpc -i eth0 -n -q -s /usr/share/udhcpc/default.script 2>&1 | tail -4
echo "--- direccion de eth0: $(ip -4 -o addr show eth0 | awk '{print $4}')"
echo "--- ruta por defecto: $(ip route | grep default)"
echo "--- /etc/resolv.conf:"
cat /etc/resolv.conf
echo "--- repositorios:"
cat /etc/apk/repositories
echo "--- apk update:"
apk update 2>&1 | tail -4
echo "--- antes: $(ls /sbin/openrc 2>&1 | tail -1)"
echo "--- apk add openrc:"
apk add openrc 2>&1 | tail -8
echo "--- despues: $(ls -l /sbin/openrc 2>&1)"
echo "--- paquetes instalados ahora: $(apk info | wc -l)"
echo "--- version de openrc: $(apk info -a openrc 2>&1 | head -1)"
echo "--- servicio de OpenRC: mi-latido"
mkdir -p /run/openrc && touch /run/openrc/softlevel
rc-service mi-latido describe 2>&1 | tail -2
rc-service mi-latido start 2>&1 | tail -3
sleep 4
echo "--- estado:"; rc-service mi-latido status 2>&1
echo "--- procesos del servicio:"; ps -o pid,ppid,args | grep -E "supervise|mi-latido" | grep -v grep
hijo=$(ps -o pid,args | grep "[/]bin/sh /usr/local/bin/mi-latido" | awk 'NR==1{print $1}')
echo "--- matamos al servicio (el hijo, PID $hijo, no al supervisor) a proposito para ver si OpenRC lo relanza"
kill -9 "$hijo" 2>&1
sleep 3
echo "--- procesos despues:"; ps -o pid,ppid,args | grep -E "supervise|mi-latido" | grep -v grep
echo "--- latidos:"; cat /tmp/mi-latido.log
rc-service mi-latido stop 2>&1 | tail -2
echo "--- estado tras parar:"; rc-service mi-latido status 2>&1
echo "=== fin de la prueba de red, apagando ==="
poweroff
