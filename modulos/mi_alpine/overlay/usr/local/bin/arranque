#!/bin/sh
# Se ejecuta una vez al terminar el arranque. Solo actua si el kernel recibio "lab=auto":
# entonces espera, muestra el estado del sistema y lo apaga.
case "$(cat /proc/cmdline)" in
*lab=red*) exec /usr/local/bin/prueba-red ;;
*lab=auto*) ;;
*) exit 0 ;;
esac
sleep 8
echo "=== prueba automatica ==="
echo "--- kernel: $(uname -sr)   hostname: $(hostname)   uptime: $(cut -d' ' -f1 /proc/uptime)s"
echo "--- /etc/alpine-release: $(cat /etc/alpine-release)"
echo "--- procesos (PID PPID COMANDO):"
ps -o pid,ppid,args | grep -v "ps -o"
echo "--- latidos de mi-servicio:"
cat /tmp/mi-servicio.log
echo "=== fin de la prueba, apagando ==="
poweroff
