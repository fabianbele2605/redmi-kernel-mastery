#!/bin/sh
# /init del TELEFONO: monta la particion ext4 (sda16, antes userdata) y pasa a vivir en ella (switch_root).
# Si no hay disco, sigue desde la RAM como antes.
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
DISCO=/dev/sda16
K=/dev/kmsg
say() { echo "init-disco: $*" > $K 2>/dev/null; echo "init-disco: $*"; }

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
say "esperando $DISCO"
for i in $(seq 1 40); do [ -b $DISCO ] && break; sleep 1; done

if [ -b $DISCO ] && mount -t ext4 $DISCO /mnt 2>/dev/null; then
	say "montado $DISCO (ext4)"
	if [ ! -x /mnt/sbin/init ]; then
		say "disco vacio: copiando el sistema (primer arranque)"
		for d in bin etc lib sbin usr var root home opt srv; do [ -e /$d ] && cp -a /$d /mnt/; done
		mkdir -p /mnt/proc /mnt/sys /mnt/dev /mnt/run /mnt/tmp /mnt/mnt
		echo "primer arranque $(date +%F-%T 2>/dev/null)" > /mnt/etc/lab-primer-arranque
		sync
		say "copia terminada"
	fi
	echo "arranque con disco: uptime $(cut -d' ' -f1 /proc/uptime) s" >> /mnt/root/arranques.txt
	sync
	mount --move /proc /mnt/proc
	mount --move /sys /mnt/sys
	mount --move /dev /mnt/dev
	say "pasando al disco"
	exec switch_root /mnt /sbin/init
fi
say "SIN disco: sigo desde la RAM"
exec /sbin/init
